If:
  PathMatch: .*\.h$

CompileFlags:
  Add: [
    "-xc++",
    "-target", "arm-none-eabi",
    "-std=c++20",
    "-fno-ms-extensions",
    "-fno-exceptions",

    # Force your local Butano implementation include folders
    "-I", "/home/bazzite/code/gba/butano/butano/include",
    "-I", "/home/bazzite/code/gba/smallbarguelike/include",


    # Force devkitARM compiler system includes explicitly
    "-isystem", "/opt/devkitpro/devkitARM/arm-none-eabi/include/c++/16.1.0/",
    "-isystem", "/opt/devkitpro/devkitARM/arm-none-eabi/include/c++/16.1.0/arm-none-eabi",
    "-isystem", "/opt/devkitpro/devkitARM/arm-none-eabi/include"
  ]
  Remove: [
    "-specs=.*",
    "-mthumb-interwork",
    "-fno-conserve-stack",
    "-mthumb"
  ]
